# Normalize line endings: LF in the repo, native in each working copy.
* text=auto

# The Gradle wrapper is a POSIX shell script run by Linux CI. A CRLF shebang
# breaks it ("bad interpreter"), so pin it to LF regardless of core.autocrlf.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts must keep CRLF.
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Never apply line-ending conversion to binaries.
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
